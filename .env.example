# Copy this file to .env and fill in real values. .env is gitignored: never commit it.

# Postgres connection string for the limited "jobs_dashboard" role (not the main postgres user).
# Supabase -> your project -> Connect -> Direct -> Type: URI, Method: Session pooler.
# Change the user to jobs_dashboard.<project-ref> and use that role's password
# (letters and numbers only, so the URL doesn't break).
DATABASE_URL=postgresql://jobs_dashboard.<project-ref>:<password>@<pooler-host>:5432/postgres

# Google account(s) allowed to sign in, comma-separated.
ALLOWED_EMAILS=you@example.com